{
  "name": "webauthn-ui",
  "version": "3.0.0",
  "description": "WebAuthn helper module",
  "repository": "https://github.com/madwizard-org/webauthn-ui",
  "main": "dist/webauthn-ui.js",
  "type": "module",
  "types": "types/index.d.ts",
  "scripts": {
    "test": "jest",
    "test-coverage": "jest --coverage",
    "lint": "eslint src tests",
    "build": "tsc --emitDeclarationOnly && rollup -c --environment NODE_ENV:development",
    "watch": "rollup -c --environment NODE_ENV:development -w",
    "build:prod": "tsc --emitDeclarationOnly && rollup -c --environment NODE_ENV:production",
    "prepublishOnly": "pnpm run build:prod"
  },
  "keywords": [
    "WebAuthn"
  ],
  "sideEffects": false,
  "files": [
    "dist/webauthn-ui.js",
    "dist/webauthn-ui.min.js",
    "types"
  ],
  "author": "Thomas Bleeker (https://www.madwizard.org)",
  "license": "MIT",
  "packageManager": "pnpm@11.23.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^30.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "3.9.10",
    "rollup": "^4.67.5",
    "ts-jest": "^29.4.15",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
